    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    caller: 'Maria Santos',\n    channel: 'phone',\n    transcript: 'Hi, I would like to ask about a website project timeline and quotation.',\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "970a9985-d1f6-45a5-a218-13013f522012",
      "name": "Example incoming call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 0]
    },
    {
      "parameters": {
        "jsCode": "return items.map(({ json }) => {\n  const text = json.transcript.toLowerCase();\n  const intent = text.includes('quotation') || text.includes('project') ? 'project inquiry' : 'general inquiry';\n  const priority = text.includes('urgent') ? 'high' : intent === 'project inquiry' ? 'normal' : 'low';\n  return { json: { ...json, intent, priority } };\n});"
      },
      "id": "a3b8f11e-b0aa-47d2-a05f-735c8a5fb319",
      "name": "Classify call intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [510, 0]
    },
    {
      "parameters": {
        "jsCode": "return items.map(({ json }) => ({\n  json: {\n    ...json,\n    reply: `Hi ${json.caller}, thanks for reaching out. I received your ${json.intent}. Benjie will review the details and reply through the contact channel you provided.`,\n    safeAction: 'Create private callback task only'\n  }\n}));"
      },
      "id": "7e5d11f9-3396-4828-a38a-92d8b8ef4f54",
      "name": "Draft polite auto-reply",
      "type": "n8n-nodes-base.code",
